        <!-- BaseRepository → UserRepository inheritance -->
        <mxCell id="e12" value="inherits" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=0;" edge="1" source="repo_base" target="repo_user" parent="lane_repo">
