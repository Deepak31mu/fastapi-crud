        <!-- Uvicorn → FastAPI App -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="uvicorn" target="fastapi_app" parent="lane_entrypoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FastAPI App → CORS -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="fastapi_app" target="cors_mw" parent="lane_entrypoint">
