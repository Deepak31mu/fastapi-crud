        <!-- Entry Point → API Layer -->
        <mxCell id="e5" value="include_router&#xa;prefix=/api/v1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;" edge="1" source="lane_entrypoint" target="lane_api" parent="1">
