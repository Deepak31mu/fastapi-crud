          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service → Repository -->
        <mxCell id="e9" value="delegates CRUD" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;" edge="1" source="lane_service" target="lane_repo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Repository → Model -->
        <mxCell id="e10" value="operates on User document" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;" edge="1" source="lane_repo" target="lane_model" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Model → DB -->
        <mxCell id="e11" value="Beanie ODM → Motor → MongoDB" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;" edge="1" source="lane_model" target="lane_db" parent="1">
          <mxGeometry relative="1" as="geometry" />
