        <!-- ══════════════════════════════════════════════════════
             ARROWS — request flow (top to bottom)
        ══════════════════════════════════════════════════════ -->

        <!-- Client → Uvicorn -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="client" target="uvicorn" parent="1">
