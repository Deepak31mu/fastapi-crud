          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Layer → DI -->
        <mxCell id="e7" value="Depends(get_user_service)" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=2;" edge="1" source="lane_schema" target="lane_di" parent="1">
